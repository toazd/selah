{
  "app-id": "com.selah.Selah",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "selah",
  "branch": "$VERSION",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-config/selah:create",
    "--socket=system-bus",
    "--talk-name=org.freedesktop.NetworkManager"
  ],
  "modules": [
    {
      "name": "selah-bundle",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/bin",
        "install -D -m755 selah /app/bin/selah",
        "cp -r lib /app/bin/",
        "cp -r data /app/bin/",
        "install -D -m644 com.selah.Selah.desktop /app/share/applications/com.selah.Selah.desktop",
        "install -D -m644 com.selah.Selah.png /app/share/icons/hicolor/256x256/apps/com.selah.Selah.png",
        "install -D -m644 com.selah.Selah.metainfo.xml /app/share/metainfo/com.selah.Selah.metainfo.xml",
      ],
      "sources": [
        {
          "type": "archive",
          "only-arches": "x86_64",
          "url": "https://github.com/toazd/selah/releases/download/v0.7.5-build.85/Selah-0.7.5.tar.gz",
          "sha256": "675f2092f6a9b18cefde844e20dc13a1ed3164781076588e5820e3b478ed4ecb"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/toazd/selah/refs/heads/main/flathub/com.selah.Selah/com.selah.Selah.desktop",
          "sha256":"366b18e39f5fcada8a06a9c3d9c5a1e0ca4393c45028de224594086a9af626f5"
        },
        {
          "type": "file",
          "url":"",
          "sha256":"366b18e39f5fcada8a06a9c3d9c5a1e0ca4393c45028de224594086a9af626f5"
        },
        {
          "type": "file",
          "path": "com.selah.Selah.metainfo.xml"
        },
        {
          "type":"file",
          "url": "https://raw.githubusercontent.com/toazd/selah/refs/heads/main/LICENSE",
          "sha256": "6b0382b16279f26ff69014300541967a356a666eb0b91b422f6862f6b7dad17e",
          "dest-filename": "LICENSE"
        }
      ]
    }
  ]
}
